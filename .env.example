# Outbound Calling & Dialer Platform Configuration
PROJECT_NAME="Outbound Calling & Dialer Service"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_production_secret_key"

# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./outbound_dialer.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/outbound_dialer"

# Telephony Configuration ("asterisk" for live FreePBX / Asterisk ARI, "mock" for dry runs)
TELEPHONY_PROVIDER="asterisk"
DEFAULT_TELEPHONY_PROVIDER="asterisk"

# Asterisk ARI Settings
ASTERISK_HOST="127.0.0.1"
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_USER="fastapi_bot"
ASTERISK_ARI_PASSWORD="your_asterisk_ari_password"
ASTERISK_STASIS_APP="outbound_dialer"
ASTERISK_OUTBOUND_TRUNK="NayatelTrunk"
ASTERISK_CONTEXT="from-internal"
ORIGINATION_MODE="LOCAL"

# Outgoing Caller ID & Extension Configuration
OUTGOING_CALLER_ID="0518490090"
DEFAULT_FROM_NUMBER="0518490090"
EXTENSION_NUMBER="2800"
EXTENSION_PASSWORD="your_extension_password"

# Optional Google Sheets Integration
GOOGLE_SHEET_NAME="Outbound Interested Leads"
GOOGLE_APPLICATION_CREDENTIALS="service_account.json"
